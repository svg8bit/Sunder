# Browser-safe public provider configuration. Never place private keys, seeds, or relay auth here.
VITE_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_DEVNET_WS_URL=wss://api.devnet.solana.com
# PublicNode is the browser-compatible best-effort fallback used by the public build.
# Replace it with a project-scoped, browser-safe RPC before funded production use.
VITE_SOLANA_MAINNET_RPC_URL=https://solana-rpc.publicnode.com
VITE_SOLANA_MAINNET_WS_URL=wss://solana-rpc.publicnode.com
VITE_EVM_SEPOLIA_RPC_URL=https://rpc.sepolia.org
VITE_EVM_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
VITE_WALLETCONNECT_PROJECT_ID=
VITE_JITO_STATUS_ENDPOINT=
VITE_NOZOMI_STATUS_ENDPOINT=
VITE_ZERO_SLOT_STATUS_ENDPOINT=

# Persistent executor. Copy only this section to /etc/sunder/executor.env.
SUNDER_EXECUTOR_HOST=127.0.0.1
SUNDER_EXECUTOR_PORT=4174
SUNDER_EXECUTOR_NETWORKS=solana:devnet,evm:sepolia
SUNDER_EXECUTOR_API_TOKEN_FILE=/etc/sunder/executor-api-token
SUNDER_EXECUTOR_AUDIT_FILE=/var/lib/sunder-executor-testnet/audit.jsonl
SUNDER_SIGNER_SOCKET=/run/sunder-signer/signer.sock
SUNDER_KILL_SWITCH=false
SUNDER_CONFIRMATION_TIMEOUT_MS=120000

# Test-network RPC and public funding addresses.
SUNDER_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SUNDER_SOLANA_DEVNET_WS_URL=wss://api.devnet.solana.com
SUNDER_SOLANA_FUNDING_ADDRESS=
SUNDER_EVM_SEPOLIA_RPC_URL=https://rpc.sepolia.org
SUNDER_EVM_FUNDING_ADDRESS=
SUNDER_FLASHBOTS_SEPOLIA_ENDPOINT=https://rpc-sepolia.flashbots.net/

# Solana relay endpoints. Authorization, when required, must be in a mode-0600 file.
SUNDER_JITO_ENDPOINT=
SUNDER_JITO_AUTHORIZATION_FILE=
SUNDER_NOZOMI_ENDPOINT=
SUNDER_ZERO_SLOT_ENDPOINT=
SUNDER_SOLANA_TIP_RECIPIENT=

# Mainnet stays locked with these defaults. Every gate is independently checked.
SUNDER_SOLANA_MAINNET_RPC_URL=
SUNDER_SOLANA_MAINNET_WS_URL=
SUNDER_EVM_MAINNET_RPC_URL=
SUNDER_FLASHBOTS_MAINNET_ENDPOINT=https://rpc.flashbots.net/fast
SUNDER_MAINNET_ENABLED=false
SUNDER_OPERATOR_CONFIRMATION=
SUNDER_SOLANA_MAINNET_MAX_SPEND_LAMPORTS=0
SUNDER_SOLANA_MAINNET_MAX_DAILY_SPEND_LAMPORTS=0
SUNDER_EVM_MAINNET_MAX_SPEND_WEI=0
SUNDER_EVM_MAINNET_MAX_DAILY_SPEND_WEI=0
