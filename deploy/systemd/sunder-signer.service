[Unit]
Description=Sunder encrypted policy signer
After=network.target
ConditionPathExists=/opt/sunder/dist/executor/packages/signer/src/server.js

[Service]
Type=simple
User=sunder-signer
Group=sunder
WorkingDirectory=/opt/sunder
Environment=NODE_ENV=production
EnvironmentFile=/etc/sunder/signer.env
ExecStart=/usr/local/bin/node /opt/sunder/dist/executor/packages/signer/src/server.js
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
UMask=0077
RuntimeDirectory=sunder-signer
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/sunder/signer
ReadWritePaths=/run/sunder-signer

[Install]
WantedBy=multi-user.target
