{
  "name": "sunder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "npm run build:ui && npm run build:executor && node scripts/prepare-sites-build.mjs",
    "build:ui": "vite build",
    "build:executor": "tsc -p tsconfig.executor.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "vitest run tests/performance/sniper.performance.test.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:sites",
    "executor:dev": "tsx packages/executor/src/server.ts",
    "executor:start": "node dist/executor/packages/executor/src/server.js",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "@pump-fun/pump-sdk": "1.36.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@solana-program/system": "0.10.0",
    "@solana/client": "^1.7.0",
    "@solana/kit": "5.5.1",
    "@solana/react-hooks": "^1.4.1",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@vitejs/plugin-react": "5.0.4",
    "bn.js": "5.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.20.0",
    "motion": "^12.42.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.84.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "viem": "2.55.10",
    "vite": "6.4.2",
    "wagmi": "3.7.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/bn.js": "5.2.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vitest": "3.2.4"
  }
}
